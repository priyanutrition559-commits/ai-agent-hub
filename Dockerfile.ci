# Validation image only. Not a production web or worker deployment.
FROM node:22-bookworm-slim AS dependencies
WORKDIR /workspace
RUN npm install --global bun@1.4.4
COPY package.json bun.lock ./
COPY packages ./packages
RUN bun install --frozen-lockfile

FROM dependencies AS quality
COPY . .
RUN npm run typecheck && npm run lint && npm test && npm run build
CMD ["node", "-e", "console.log('Validation image only; no application or MCP server is started.')"]
